[Unit]
Description=Chicago data bot health (scheduled by Petit)

[Service]
Type=oneshot
User=chicago-data-bot
Group=chicago-data-bot
WorkingDirectory=/var/lib/chicago-data-bot
ExecStart=/opt/chicago-data-bot/current/chicago-data-bot --state /var/lib/chicago-data-bot/catalog.sqlite check --health
TimeoutStartSec=60
MemoryMax=48M
MemorySwapMax=16M
CPUQuota=25%
TasksMax=16
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# SQLite read-only connections may need to create WAL coordination sidecars.
# The Rust check still opens the database with SQLITE_OPEN_READ_ONLY.
ReadWritePaths=/var/lib/chicago-data-bot
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
